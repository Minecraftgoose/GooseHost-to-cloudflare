# _redirects

# ---------- 静态资源 ----------
/dashboard/*.js   /dashboard/:splat.js   200
/dashboard/*.css  /dashboard/:splat.css  200
/dashboard/*.json /dashboard/:splat.json 200

# ---------- Dashboard SPA 回退 ----------
/dashboard /dashboard/ 301
/dashboard/deploy /dashboard/ 200
/dashboard/mysite /dashboard/ 200
/dashboard/mysite/* /dashboard/ 200
/dashboard/settings /dashboard/ 200
/dashboard/account /dashboard/ 200
/dashboard/copilot /dashboard/ 200
/dashboard/preferences /dashboard/ 200
/dashboard/playground /dashboard/ 200
/dashboard/me /dashboard/ 200
/dashboard.html /dashboard/ 301

# ---------- 其他 SPA ----------
/status /status/ 301
# 下面这些旧路径一律直达带尾斜杠的规范地址。
# 写成 /x 的话，Pages 还会把 /x 再 308 到 /x/，白白多一次往返。
/status.html /status/ 301

# ---------- 旧路径 301 规范化（一跳到位） ----------
/login.html /login/ 301
/register.html /register/ 301
/admin.html /admin/ 301
/reset-password.html /reset-password/ 301
/playground /playground/ 301